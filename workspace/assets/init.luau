					SalesTypeFilter = args.SalesTypeFilter,
					Topics = args.Topics,
					limit = args.limit,
					cursor = args.cursor,
					sortOrder = args.sortOrder,
				},
				responseKind = OpenApiRuntime.ResponseKind.Json,
			}
