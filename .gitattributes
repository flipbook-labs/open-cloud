# Tools write these files rather than people, so GitHub collapses their diffs
# in pull requests and leaves them out of language stats. `lute run generate`
# writes each member's client, `lute run update-spec` writes the spec pin, and
# `changewrite generate` writes the changelog chips.
workspace/*/init.luau linguist-generated=true
workspace/*/types.luau linguist-generated=true
spec/source.luau linguist-generated=true
.changes/assets/** linguist-generated=true
